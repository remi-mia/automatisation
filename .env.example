# --- SMTP (envoi du brief par email) ---
# Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=ton@gmail.com
# SMTP_PASS = "mot de passe d'application" Google (pas le mot de passe du compte)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Expéditeur affiché (optionnel, défaut = SMTP_USER)
MAIL_FROM=

# Destinataire fixe du brief
MAIL_TO=maximilien@made-in-ai.fr

# --- Sécurité du webhook (optionnel) ---
# Secret de signature Tally. Si défini, les requêtes non signées sont rejetées.
TALLY_SIGNING_SECRET=
