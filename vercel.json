{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/tally-webhook.js": {
      "includeFiles": "templates/**",
      "maxDuration": 30
    },
    "api/veille.py": {
      "includeFiles": "veille-appels-offres/**",
      "maxDuration": 60
    },
    "api/releve-mails.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/connexion-gmail", "destination": "/connexion-gmail.html" }
  ],
  "crons": [
    { "path": "/api/releve-mails", "schedule": "*/15 * * * *" }
  ]
}
